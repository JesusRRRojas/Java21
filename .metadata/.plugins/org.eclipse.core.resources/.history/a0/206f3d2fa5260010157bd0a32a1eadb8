	@GET
	@Path("/departamentos/{codDepartamento}/provincias")
	public Response getProvincia (@PathParam("codDepartamento") String codDepartamento, @QueryParam("nombre") String nombre )throws ServiceException 
	{
		List<ProvinciaDto> provincias = provinciaService.findNombreLikeCustom(codDepartamento, nombre);
		return Response.ok().entity(provincias).build();	
	}

