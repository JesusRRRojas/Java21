	@GET
	@Path("/provincias/{codProvincia}/distritos")
	public Response getDistrito (@PathParam("codProvincia") String codProvincia, @QueryParam("nombre") String nombre )throws ServiceException 
	{
		System.out.println(" == getDistrito ==");
		List<DistritoDto> distrito = distritoService.findNombreLikeCustom(codProvincia, nombre);
		return Response.ok().entity(distrito).build();
	}
	
