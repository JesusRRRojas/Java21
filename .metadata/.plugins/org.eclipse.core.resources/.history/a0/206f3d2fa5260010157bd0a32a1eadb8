	@Operation(
	        summary = "Obtener lista de departamentos", 
	        description = "Devuelve una lista de departamentos que coinciden con el nombre proporcionado"
	    )
	    @ApiResponses(value = {
	        @ApiResponse(responseCode = "200", description = "Departamentos encontrados"),
	        @ApiResponse(responseCode = "400", description = "Petición incorrecta")
	    })
	
	@GET
	@Path("/departamentos")
	public Response getDepartamento (
			@Parameter(description = "Nombre parcial del departamento") 
			@QueryParam("nombre") String nombre) throws ServiceException
	{
		System.out.println(" == getDepartameentos ==");
		//departamentoService = new DepartamentoServiceImpl();
		List<DepartamentoDto> departamentos = departamentoService.findNombreLikeCustom(nombre);
		return Response.ok().entity(departamentos).build();	
	}
	
