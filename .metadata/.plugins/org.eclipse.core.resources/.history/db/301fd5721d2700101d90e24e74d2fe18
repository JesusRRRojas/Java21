package com.pe.proyecto.api_jersey.escuelaConductores.service;

import static java.util.Objects.isNull;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.pe.proyecto.api_jersey.escuelaConductores.Repository.ProvinciaRepository;
import com.pe.proyecto.api_jersey.escuelaConductores.dto.ProvinciaDto;
import com.pe.proyecto.api_jersey.escuelaConductores.entity.id.ProvinciaId;
import com.pe.proyecto.api_jersey.escuelaConductores.mapper.ProvinciaMapper;

@Service
public class ProvinciaServiceImpl implements ProvinciaService {

	@Autowired
	private ProvinciaRepository provinciaRepository;
	
	@Autowired
	private ProvinciaMapper provinciaMapper;
	
	@Override
	public List<ProvinciaDto> findNombreLikeCustom(String codigoDepartamento, String nombre) throws ServiceException {
		nombre = "%" + (isNull(nombre) ? "" : nombre) + "%";
		return provinciaRepository.findNombreLikeCustom(codigoDepartamento, nombre).stream().map(p->provinciaMapper.toDTO(p)).toList();
	
	}

	@Override
	public ProvinciaDto findById(String codDepartamento, String codProvincia) throws ServiceException {
		ProvinciaId id = new ProvinciaId();
		id.setCOD_DEP(codProvincia);
		id.setCOD_PRO(codProvincia);
		
		System.out.println(id.toString());
		
		
		var prov = provinciaRepository.findById(id);
		
		
		System.out.println(prov.toString());
		
	    return prov.map(provinciaMapper::toDTO)
                .orElseThrow(() -> new ServiceException("Provincia no encontrado con código: " + codDepartamento + " - " + codProvincia ));
	}
	

}
