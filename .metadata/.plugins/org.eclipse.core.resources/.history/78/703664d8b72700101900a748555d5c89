	*/

	
	public DistritoId getID() {
		return ID;
	}

	public void setID(DistritoId iD) {
		ID = iD;
	}

	public String getNOMBRE() {
		return NOMBRE;
	}
	public void setNOMBRE(String NOMBRE) {
		this.NOMBRE = NOMBRE;
	}

	@Override
	public String toString() {
		return "DistritoEntity [ID=" + ID + ", NOMBRE=" + NOMBRE + "]";
	}

	
	
}
